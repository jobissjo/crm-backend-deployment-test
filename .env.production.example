# Copy to .env.production and replace both secrets.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
# Must match the PostgreSQL credentials above. URL-encode special characters.
DATABASE_URL=postgresql+asyncpg://crm:replace-with-random-alphanumeric-password@db:5432/crm
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
CRM_IMAGE=async-crm:production
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
